<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>Label</key>
	<string>com.literalcreative.signalripper</string>

	<key>ProgramArguments</key>
	<array>
		<string>/Users/literalcreative/srv/apps/signalripper/.venv/bin/python3</string>
		<string>start.py</string>
		<string>--no-open</string>
	</array>

	<key>WorkingDirectory</key>
	<string>/Users/literalcreative/srv/apps/signalripper</string>

	<key>EnvironmentVariables</key>
	<dict>
		<key>PATH</key>
		<string>/Users/literalcreative/srv/apps/signalripper/.venv/bin:/usr/local/bin:/usr/bin:/bin:/usr/sbin:/sbin</string>
	</dict>

	<key>RunAtLoad</key>
	<true/>

	<key>KeepAlive</key>
	<true/>

	<key>ThrottleInterval</key>
	<integer>10</integer>

	<key>StandardOutPath</key>
	<string>/Users/literalcreative/srv/logs/signalripper.out.log</string>

	<key>StandardErrorPath</key>
	<string>/Users/literalcreative/srv/logs/signalripper.err.log</string>
</dict>
</plist>
